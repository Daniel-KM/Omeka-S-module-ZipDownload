{
    "name": "daniel-km/omeka-s-module-zip-download",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Stream resource files as zip archives for download. Provides a download button with confirmation dialog showing file size.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "block",
        "page",
        "theme"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-ZipDownload",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-ZipDownload/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.1",
        "daniel-km/omeka-s-module-common": "*"
    },
    "require": {
        "php": "^8.1",
        "maennchen/zipstream-php": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "ZipDownload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZipDownloadTest\\": "tests/ZipDownloadTest/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "extra": {
        "installer-name": "ZipDownload"
    }
}
