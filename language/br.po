#: data/scripts/upgrade.php:33 Module.php:62
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Ar modul %1$s a rank bezañ hizivaet d'ar stumm %2$s pe unan nevesoc'h."

#: data/scripts/upgrade.php:37
msgid "Missing requirement. Unable to upgrade."
msgstr "Rekizadenn a vank. N'haller ket hizivaat."

#: Module.php:70
msgid ""
"This module requires PHP 8.1 or later for zip streaming with ZipStream "
"library."
msgstr ""
"Ezhomm en deus ar modul-mañ eus PHP 8.1 pe un doare nevesoc'h evit ar "
"streaming zip gant al levraoueg ZipStream."

#: src/View/Helper/DownloadZip.php:76 src/View/Helper/DownloadZip.php:411
msgid "Download"
